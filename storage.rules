rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function is_green_room() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@greenroomcannabis[.]com$');
    }

    match /metrc-uploads/{allPaths=**} {
      allow read: if is_green_room();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
